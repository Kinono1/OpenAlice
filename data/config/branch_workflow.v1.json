{
  "version": "v1",
  "policyName": "openalice-three-branch-workflow",
  "updatedAt": "2026-03-01T00:00:00Z",
  "remotes": {
    "official": "origin",
    "personal": "kino"
  },
  "branches": {
    "official_sync": "master",
    "work_mainline": "work/kino-mainline",
    "integration": "dev"
  },
  "roleDefinition": {
    "official_sync": "Track official upstream changes only. Do not develop features here.",
    "work_mainline": "Primary algorithm and product development branch.",
    "integration": "Integration branch for combining official_sync and work_mainline."
  },
  "rules": {
    "defaultDevelopmentBranch": "work/kino-mainline",
    "allowedMergeDirections": [
      {
        "from": "master",
        "to": "dev"
      },
      {
        "from": "work/kino-mainline",
        "to": "dev"
      },
      {
        "from": "dev",
        "to": "work/kino-mainline"
      }
    ],
    "forbiddenMergeDirections": [
      {
        "from": "work/kino-mainline",
        "to": "master"
      },
      {
        "from": "master",
        "to": "work/kino-mainline"
      },
      {
        "from": "dev",
        "to": "master"
      }
    ],
    "cleanupBranches": [
      "backup/local-before-sync-20260228-224259",
      "integrate/governance-f0d40af-r1"
    ]
  },
  "enforcement": {
    "enabled": true,
    "hooksPath": ".githooks",
    "prePush": {
      "enabled": true,
      "blockUnknownBranches": true,
      "allowedPushDirections": [
        {
          "from": "master",
          "to": "master"
        },
        {
          "from": "work/kino-mainline",
          "to": "work/kino-mainline"
        },
        {
          "from": "dev",
          "to": "dev"
        }
      ],
      "forbiddenPushDirections": [
        {
          "from": "work/kino-mainline",
          "to": "master"
        },
        {
          "from": "dev",
          "to": "master"
        },
        {
          "from": "master",
          "to": "dev"
        },
        {
          "from": "master",
          "to": "work/kino-mainline"
        }
      ],
      "branchRemotePolicy": [
        {
          "branch": "master",
          "allowedRemoteRoles": [
            "official"
          ]
        },
        {
          "branch": "work/kino-mainline",
          "allowedRemoteRoles": [
            "personal"
          ]
        },
        {
          "branch": "dev",
          "allowedRemoteRoles": [
            "personal"
          ]
        }
      ]
    }
  },
  "workflow": [
    "1) Develop features on work_mainline (or short-lived feature branches that merge back to work_mainline).",
    "2) Sync official updates on official_sync only.",
    "3) Merge official_sync + work_mainline into integration and run full validation.",
    "4) If integration passes, merge integration back into work_mainline.",
    "5) Keep official_sync clean as upstream mirror."
  ]
}
