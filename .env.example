# Exchange API
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSWORD=              # Optional: for exchanges requiring passphrase (OKX, etc.)
TRADE_TOKEN=                    # Required by trade interface guard unless disabled
AUTH_TOKEN=                     # Alternate token accepted by trade interface guard
ALLOW_LIVE_TRADING=false        # Keep false unless intentionally enabling real live trading
DISABLE_TRADE_AUTH_TOKEN_ENFORCE=false  # Debug-only bypass for token guard
REALTIME_DATA_API_URL=          # Optional override; default uses DotAPI sandbox feed

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
