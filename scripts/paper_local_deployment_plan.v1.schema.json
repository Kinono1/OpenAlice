{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper_local_deployment_plan.v1",
  "description": "Closed wire shape only. This schema is not an authorization validator; consumers must also call validatePaperLocalDeploymentPlan with a current freshAt and enforce its relational bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "planId", "createdAt", "expiresAt", "release", "runtime", "identities", "supervisor", "launchd", "attestations", "capabilities"],
  "properties": {
    "schemaVersion": {"const": "paper_local_deployment_plan.v1"},
    "status": {"const": "plan_only"},
    "planId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "release": {"type": "object", "additionalProperties": false, "required": ["releaseRoot", "releaseId", "materializedDirectory", "manifestHash", "sourceCommit", "runtimeEntry", "shellLauncherPath", "shellLauncherSha256", "mjsLauncherPath", "mjsLauncherSha256"], "properties": {"releaseRoot": {"type": "string", "pattern": "^/"}, "releaseId": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "materializedDirectory": {"type": "string", "pattern": "^/"}, "manifestHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "runtimeEntry": {"const": "ops/release/launch_nautilus_paper.sh"}, "shellLauncherPath": {"type": "string", "pattern": "^/"}, "shellLauncherSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "mjsLauncherPath": {"type": "string", "pattern": "^/"}, "mjsLauncherSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["node", "python"], "properties": {"node": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "python": {"type": "object", "additionalProperties": false, "required": ["path", "resolvedPath", "interpreterHash", "pyvenvCfgHash", "baseRuntimeAggregate", "sitePackagesAggregate", "installedAggregate", "target"], "properties": {"path": {"type": "string", "pattern": "^/"}, "resolvedPath": {"type": "string", "pattern": "^/"}, "interpreterHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "pyvenvCfgHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "baseRuntimeAggregate": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "sitePackagesAggregate": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "installedAggregate": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "target": {"type": "object", "additionalProperties": false, "required": ["implementation", "python", "cacheTag", "system", "macosMajor", "machine"], "properties": {"implementation": {"const": "CPython"}, "python": {"const": "3.13.5"}, "cacheTag": {"const": "cpython-313"}, "system": {"const": "Darwin"}, "macosMajor": {"const": 26}, "machine": {"const": "arm64"}}}}}}},
    "identities": {"type": "object", "additionalProperties": false, "required": ["publisherUid", "serviceUid"], "properties": {"publisherUid": {"type": "integer", "minimum": 0}, "serviceUid": {"type": "integer", "minimum": 1}}},
    "supervisor": {"type": "object", "additionalProperties": false, "required": ["configPath", "canonicalSha256", "schemaPath", "schemaSha256", "mode", "releaseManifestHash"], "properties": {"configPath": {"type": "string", "pattern": "^/"}, "canonicalSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "schemaPath": {"const": "sidecars/nautilus_paper/supervisor_config.v1.schema.json"}, "schemaSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "mode": {"const": "PAPER_LOCAL"}, "releaseManifestHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "launchd": {"type": "object", "additionalProperties": false, "required": ["label", "plistPath", "serviceDomain", "programArguments", "workingDirectory", "runAtLoad", "keepAlive", "standardOutPath", "standardErrorPath", "environmentVariables", "payloadSha256"], "properties": {"label": {"type": "string"}, "plistPath": {"type": "string", "pattern": "^/"}, "serviceDomain": {"type": "string", "pattern": "^gui/[1-9][0-9]*$"}, "programArguments": {"type": "array", "prefixItems": [{"const": "/bin/sh"}, {"type": "string", "pattern": "^/"}, {"const": "--release-root"}, {"type": "string", "pattern": "^/"}, {"const": "--release-id"}, {"type": "string", "pattern": "^[a-f0-9]{40}$"}, {"const": "--config"}, {"type": "string", "pattern": "^/"}], "items": false, "minItems": 8, "maxItems": 8}, "workingDirectory": {"type": "string", "pattern": "^/"}, "runAtLoad": {"const": true}, "keepAlive": {"const": true}, "standardOutPath": {"type": "string", "pattern": "^/"}, "standardErrorPath": {"type": "string", "pattern": "^/"}, "environmentVariables": {"type": "object", "additionalProperties": false, "required": ["OPENALICE_RELEASE_DIR", "OPENALICE_PAPER_LOCAL_SUPERVISOR_CONFIG", "OPENALICE_NODE", "OPENALICE_NODE_SHA256", "OPENALICE_PAPER_LOCAL_MJS_SHA256", "OPENALICE_NAUTILUS_PYTHON", "OPENALICE_RELEASE_PUBLISHER_UID"], "properties": {"OPENALICE_RELEASE_DIR": {"type": "string", "pattern": "^/"}, "OPENALICE_PAPER_LOCAL_SUPERVISOR_CONFIG": {"type": "string", "pattern": "^/"}, "OPENALICE_NODE": {"type": "string", "pattern": "^/"}, "OPENALICE_NODE_SHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "OPENALICE_PAPER_LOCAL_MJS_SHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "OPENALICE_NAUTILUS_PYTHON": {"type": "string", "pattern": "^/"}, "OPENALICE_RELEASE_PUBLISHER_UID": {"type": "string", "pattern": "^[0-9]+$"}}}, "payloadSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "attestations": {"type": "array", "prefixItems": [{"const": "paper_local_operator_authorization_attestation.v1"}, {"const": "paper_local_release_materialization_attestation.v1"}, {"const": "paper_local_launcher_pair_attestation.v1"}, {"const": "paper_local_runtime_environment_attestation.v1"}, {"const": "paper_local_supervisor_config_attestation.v1"}, {"const": "paper_local_launchd_installation_attestation.v1"}, {"const": "paper_local_service_execution_control_attestation.v1"}, {"const": "paper_local_post_start_attestation.v1"}], "items": false, "minItems": 8, "maxItems": 8},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["install", "start", "launchctl", "pointerMutation", "broker", "network", "liveExecution", "mutation", "deploymentAuthorized", "deploymentPerformed"], "properties": {"install": {"const": false}, "start": {"const": false}, "launchctl": {"const": false}, "pointerMutation": {"const": false}, "broker": {"const": false}, "network": {"const": false}, "liveExecution": {"const": false}, "mutation": {"const": false}, "deploymentAuthorized": {"const": false}, "deploymentPerformed": {"const": false}}}
  }
}
