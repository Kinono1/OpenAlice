{
  "name": "open-alice",
  "version": "0.9.0-beta.8",
  "description": "File-based trading agent engine",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:ui": "corepack pnpm --filter open-alice-ui dev",
    "predev": "corepack pnpm --filter opentypebb build && corepack pnpm --filter @traderalice/ibkr build",
    "build": "corepack pnpm --filter opentypebb build && corepack pnpm --filter @traderalice/ibkr build && corepack pnpm build:ui && corepack pnpm build:backend",
    "build:ui": "corepack pnpm --filter open-alice-ui build",
    "build:backend": "tsup src/main.ts --format esm --dts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:all": "corepack pnpm test && corepack pnpm test:scripts",
    "test:release": "corepack pnpm test && corepack pnpm test:scripts && corepack pnpm test:e2e",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "decision:validate": "python3 scripts/validate_decision_packet.py",
    "governance:validate": "python3 scripts/validate_decision_packet.py --output /tmp/openalice_decision_verdict.validation.json",
    "test:watch": "vitest",
    "research:strategy:mvp-validate": "tsx scripts/run_strategy_mvp_validation.ts",
    "research:strategy:validate": "tsx scripts/run_validation_pipeline.ts",
    "research:alpha-pool:materialize": "tsx scripts/materialize_alpha_pool.ts",
    "research:strategy:factor-mean-reversion": "tsx scripts/run_factor_mean_reversion_validation.ts",
    "research:eth-carry:install-cron": "tsx scripts/install_eth_carry_refresh_cron.ts",
    "research:eth-carry:short-bias-validate": "tsx scripts/run_eth_carry_short_bias_validation.ts",
    "service:openalice:install-launchd": "tsx scripts/install_openalice_launchd.ts",
    "research:eth-carry:refresh-pipeline": "tsx scripts/refresh_eth_carry_pipeline.ts",
    "research:eth-carry:refresh-status": "tsx scripts/refresh_eth_carry_runtime_status.ts",
    "research:tradingagents:terminal-governance": "tsx scripts/run_tradingagents_terminal_governance.ts",
    "research:openalice:completion": "tsx scripts/run_openalice_completion.ts",
    "research:ml:train": "python3 research/ml-training/train_patchtst.py",
    "research:ml:export-onnx": "python3 research/ml-training/export_onnx.py",
    "research:meta:train": "python3 research/ml-training/train_meta_labeling.py",
    "research:qcm:train": "python3 research/distributional_rl/train_qcm.py",
    "research:ic:run": "python3 research/ic-research/run_ic_analysis.py",
    "research:ic:multi": "python3 research/ic-research/run_multi_asset_ic_analysis.py",
    "branch:policy:show": "node scripts/branch_policy.mjs --show",
    "branch:policy:check": "node scripts/branch_policy.mjs --check-current",
    "branch:policy:can-merge": "node scripts/branch_policy.mjs --check-merge",
    "branch:policy:enforce-push": "node scripts/branch_policy_enforce_push.mjs",
    "branch:policy:install-hooks": "bash scripts/branch_policy_install_hooks.sh",
    "optimize:cross-sectional": "tsx scripts/optimize_cross_sectional.ts",
    "promotion:v2:publish": "tsx scripts/publish_promotion_v2_runtime_bundle.ts",
    "improve:loop": "tsx scripts/continuous_improvement_loop.ts",
    "data:download-multi": "tsx scripts/download_multi_assets.ts",
    "validate:new-strategies": "tsx scripts/run_new_strategies_validation.ts",
    "paper:cross-sectional": "tsx scripts/paper_trade_cross_sectional.ts",
    "paper:shadow-loop": "tsx scripts/run_paper_shadow_loop.ts",
    "paper:shadow-loop:live": "tsx scripts/run_paper_shadow_loop.ts --paperDataMode live_only",
    "paper:monitor": "tsx scripts/run_realtime_shadow_monitor.ts",
    "paper:monitor:once": "tsx scripts/run_realtime_shadow_monitor.ts --once true",
    "data:accumulate": "tsx scripts/accumulate_live_data.ts",
    "data:accumulate-5m": "tsx scripts/accumulate_5m_data.ts",
    "data:accumulate-1s": "tsx scripts/accumulate_1s_data.ts",
    "paper:microstructure-stress": "tsx scripts/paper_trade_microstructure_stress.ts",
    "paper:volume-breakout": "tsx scripts/paper_trade_volume_breakout.ts",
    "paper:pnl:diagnose": "tsx scripts/analyze_paper_pnl.ts",
    "paper:pro-policy-window": "tsx scripts/analyze_pro_policy_window.ts",
    "paper:microstructure-stoploss-replay": "tsx scripts/run_microstructure_stoploss_replay.ts",
    "paper:microstructure-stoploss-cluster-review": "tsx scripts/build_microstructure_stoploss_cluster_review.ts",
    "paper:policy-shadow:settle": "tsx scripts/settle_paper_policy_shadow_ledger.ts",
    "paper:policy-shadow:capture": "tsx scripts/capture_policy_shadow_opportunities.ts",
    "paper:p1-evidence": "tsx scripts/build_p1_trading_evidence.ts",
    "paper:meta-labeling:readiness": "tsx scripts/build_meta_labeling_shadow_readiness.ts",
    "external:derivatives:collect": "tsx scripts/collect_external_derivatives_data.ts",
    "audit:dirty-worktree": "tsx scripts/audit_dirty_worktree.ts",
    "audit:dirty-quarantine-plan": "tsx scripts/build_dirty_quarantine_plan.ts",
    "research:alpha-hypothesis:registry": "tsx scripts/build_alpha_hypothesis_registry.ts",
    "evidence:validate-trust": "tsx scripts/validate_evidence_trust.ts",
    "market:intel:refresh": "tsx scripts/refresh_market_intel_context.ts",
    "status:runtime-truth": "tsx scripts/refresh_runtime_truth_status.ts",
    "status:ic-snapshot": "tsx scripts/publish_ic_monitor_snapshot.ts",
    "status:ic-monitor": "tsx scripts/build_ic_monitor_status.ts",
    "status:reason-chain": "tsx scripts/build_system_status_reason_chain.ts",
    "cp:intake": "tsx scripts/intake_currencypurchases_signals.ts"
  },
  "keywords": [
    "trading",
    "ai-agent",
    "crypto",
    "securities",
    "file-driven"
  ],
  "author": "Open Alice Contributors",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraderAlice/OpenAlice.git"
  },
  "homepage": "https://traderalice.com",
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.44",
    "@ai-sdk/google": "^3.0.30",
    "@ai-sdk/openai": "^3.0.30",
    "@alpacahq/alpaca-trade-api": "^3.1.3",
    "@anthropic-ai/claude-agent-sdk": "^0.2.72",
    "@grammyjs/auto-retry": "^2.0.2",
    "@hono/node-server": "^1.19.11",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sinclair/typebox": "0.34.48",
    "@traderalice/ibkr": "workspace:*",
    "@traderalice/opentypebb": "workspace:*",
    "ai": "^6.0.86",
    "ajv": "^8.18.0",
    "ccxt": "^4.5.38",
    "chalk": "^5.6.2",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "file-type": "^21.3.2",
    "grammy": "^1.40.0",
    "hono": "^4.12.7",
    "json5": "^2.2.3",
    "pino": "^10.3.1",
    "playwright-core": "1.58.2",
    "sharp": "^0.34.5",
    "tslog": "^4.10.2",
    "undici": "^7.24.4",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "overrides": {
      "@alpacahq/alpaca-trade-api>axios": "^0.30.3",
      "@alpacahq/alpaca-trade-api>eslint": "-"
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^29.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
