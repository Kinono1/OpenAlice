{
  "name": "open-alice",
  "version": "1.0.0",
  "description": "File-based trading agent engine",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/main.ts",
    "dev:ui": "cd ui && pnpm dev",
    "build": "pnpm build:ui && pnpm build:backend",
    "build:ui": "cd ui && pnpm install && pnpm build",
    "build:backend": "tsup src/main.ts --format esm --dts",
    "data:download:okx": "tsx --env-file=.env scripts/okx_download_ohlcv.ts",
    "data:download:binance": "tsx scripts/binance_public_download_klines.ts",
    "data:report:universe": "tsx scripts/market_universe_report.ts",
    "train:full-pipeline": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/wait_clean_and_retrain.py",
    "train:full-pipeline:conda": "PYTHONWARNINGS=ignore python scripts/wait_clean_and_retrain.py",
    "train:cvar-next-matrix": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/run_cvar_next_matrix.py",
    "train:cvar-next-watch": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/monitor_cvar_next_matrix.py",
    "research:strategy-watch": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/strategy_research_watch.py",
    "research:strategy-watch:daily": "bash scripts/daily_strategy_watch.sh",
    "research:strategy-optimize-loop": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/strategy_optimize_loop.py",
    "research:strategy-drain-queue": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/drain_strategy_queue.py",
    "research:strategy-health-check": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/strategy_pipeline_health_check.py",
    "research:strategy-health-check:daily": "bash scripts/daily_strategy_health_check.sh",
    "research:strategy-governance:daily": "bash scripts/daily_strategy_governance.sh",
    "research:strategy-governance:dry": "DRY_RUN=1 bash scripts/daily_strategy_governance.sh",
    "research:gate-summary": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/gate_summary_snapshot.py",
    "research:failure-breakdown": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/failure_breakdown.py",
    "research:failure-breakdown:daily": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/failure_breakdown.py --windows 8,20,30",
    "research:external-benchmark": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/external_benchmark_harness.py",
    "research:external-benchmark:probe": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/external_benchmark_harness.py --probe-tools",
    "research:external-benchmark:init": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/external_benchmark_harness.py --create-example-manifest --dry-run",
    "research:strategy-admission": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/strategy_admission_gate.py",
    "research:strategy-admission:dry": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/strategy_admission_gate.py --dry-run",
    "research:pick-optimize-direction": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/pick_optimize_direction.py",
    "research:pick-optimize-direction:adaptive": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/pick_optimize_direction.py --mode adaptive",
    "research:strategy-search": "PYTHONWARNINGS=ignore ./.venv/bin/python scripts/continuous_strategy_search.py",
    "research:strategy-optimize-loop:daily": "bash scripts/daily_strategy_optimize.sh",
    "research:sprint:deadline": "bash scripts/sprint_push_until_deadline.sh",
    "research:sprint:smoke": "MAX_CYCLES=1 INTERVAL_SECONDS=1 RUN_REVIEW_GATE=0 RUN_DATA_PULL=0 bash scripts/sprint_push_until_deadline.sh",
    "ml:eval": "tsx scripts/ml_ensemble_eval.ts",
    "validation:run": "node --import tsx scripts/run_validation_pipeline.ts",
    "validation:completion": "node --import tsx scripts/run_openalice_completion.ts",
    "evidence:build": "node --import tsx scripts/python_fallback.ts scripts/build_decision_packet.py",
    "evidence:validate": "node --import tsx scripts/python_fallback.ts scripts/validate_decision_packet.py",
    "runtime:replay-state": "node --import tsx scripts/python_fallback.ts scripts/replay_runtime_state.py",
    "freeze:verify": "node --import tsx scripts/python_fallback.ts scripts/verify_freeze_manifest.py",
    "ramp:promote-stage": "node --import tsx scripts/promote_stage.ts",
    "review:repo": "python3 scripts/systematic_review_gate.py --mode repo",
    "review:changed": "python3 scripts/systematic_review_gate.py --mode changed",
    "review:gate": "python3 scripts/systematic_review_gate.py --mode changed --block-severities critical,high",
    "test:ts": "vitest run",
    "test:py:governance": "python3 -m unittest scripts.tests.test_governance_pipeline",
    "test": "pnpm test:ts && pnpm test:py:governance",
    "test:watch": "vitest"
  },
  "keywords": [
    "trading",
    "ai-agent",
    "crypto",
    "securities",
    "file-driven"
  ],
  "author": "Open Alice Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraderAlice/OpenAlice.git"
  },
  "homepage": "https://traderalice.com",
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.44",
    "@ai-sdk/openai": "^3.0.0",
    "@alpacahq/alpaca-trade-api": "^3.1.3",
    "@grammyjs/auto-retry": "^2.0.2",
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@sinclair/typebox": "0.34.48",
    "ai": "^6.0.86",
    "ajv": "^8.18.0",
    "ccxt": "^4.5.38",
    "chalk": "^5.6.2",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "file-type": "^21.3.0",
    "grammy": "^1.40.0",
    "hono": "^4.11.9",
    "json5": "^2.2.3",
    "pino": "^10.3.1",
    "playwright-core": "1.58.2",
    "sharp": "^0.34.5",
    "tslog": "^4.10.2",
    "undici": "^7.22.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
