{
  "name": "open-alice",
  "version": "1.0.0",
  "description": "File-based trading agent engine",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:ui": "cd ui && pnpm dev",
    "build": "pnpm build:ui && pnpm build:backend",
    "build:ui": "cd ui && pnpm install && pnpm build",
    "build:backend": "tsup src/main.ts --format esm --dts",
    "data:download:okx": "tsx scripts/okx_download_ohlcv.ts",
    "data:download:okx:catalog": "tsx scripts/okx_build_catalog.ts",
    "data:download:okx:candles": "tsx scripts/okx_download_candles_historical.ts",
    "data:download:okx:index": "tsx scripts/okx_download_index_candles.ts",
    "data:download:okx:trades": "tsx scripts/okx_download_trades.ts",
    "data:import:okx:trades-history": "tsx scripts/okx_import_historical_trades.ts",
    "data:download:okx:full": "tsx scripts/okx_download_full_dataset.ts",
    "data:report:okx:coverage": "tsx scripts/okx_data_coverage_report.ts",
    "data:materialize:okx:training": "tsx scripts/okx_materialize_training_csv.ts",
    "data:download:binance": "tsx scripts/binance_public_download_klines.ts",
    "data:report:universe": "tsx scripts/market_universe_report.ts",
    "ml:eval": "tsx scripts/ml_ensemble_eval.ts",
    "branch:policy:show": "node scripts/branch_policy.mjs --show",
    "branch:policy:check": "node scripts/branch_policy.mjs --check-current",
    "branch:policy:can-merge": "node scripts/branch_policy.mjs --check-merge",
    "branch:policy:enforce-push": "node scripts/branch_policy_enforce_push.mjs",
    "branch:policy:install-hooks": "bash scripts/branch_policy_install_hooks.sh",
    "baseline:snapshot": "python3 scripts/capture_baseline_snapshot.py --output-dir data/runtime",
    "env:verify": "python3 scripts/verify_environment_lock.py --lock docs/research/templates/environment_lock.v1.json --output data/runtime/environment_verify_report.json",
    "freeze:verify": "python3 scripts/verify_freeze_manifest.py --manifest docs/research/freeze_manifest.json --schema docs/research/templates/freeze_manifest.schema.v1.json --output data/runtime/freeze_verify_report.json",
    "gates:preflight": "python3 scripts/gates_preflight.py --output data/runtime/gates_preflight_report.json",
    "gates:checkpoints": "python3 scripts/build_gate_checkpoints.py --output-dir data/runtime/gates",
    "research:watch": "python3 scripts/strategy_research_watch.py --sources arxiv,openalex --query-profile crypto_plus --citation-depth 1",
    "research:hypothesis-compile": "python3 scripts/research_hypothesis_compile.py",
    "research:pdf:extract": "python3 scripts/research_pdf_extract.py",
    "research:citation:build": "python3 scripts/build_citation_network.py --include-external-refs",
    "research:frontier:shortlist": "python3 scripts/research_fdr_shortlist.py",
    "research:contracts:validate": "python3 scripts/validate_research_contracts.py --inputs data/research/hypotheses/backlog.v1.json data/research/literature/citations/latest_citation_network.v1.json data/research/literature/pdf_extract/latest_pdf_extract_report.v1.json data/research/strategy/analysis/g3g4/plan_switchboard.latest.v1.json data/research/strategy/baselines/provisional_best_20260303.v1.json data/research/strategy/analysis/g3g4/latest_fdr_bottleneck_report.v1.json data/research/strategy/analysis/g3g4/latest_multi_asset_matrix.v1.json data/research/strategy/analysis/g3g4/latest_threshold_sensitivity.v1.json data/research/strategy/analysis/g3g4/precontinue_decision.v1.json data/research/strategy/analysis/g3g4/stagea_gate_result.v1.json data/research/strategy/analysis/g3g4/stageb_governance_packet.v1.json data/research/strategy/governance/quant_policy_pack.v1.json data/research/strategy/governance/advisor_committee_packet.v1.json data/research/strategy/governance/quant_hiring_scorecard.v1.json data/research/strategy/governance/paper_board.v1.json",
    "research:mvp": "python3 scripts/build_paper_cards.py --source-manifest docs/research/papers/top_venue_20260228/deep_read_manifest.json --out-dir data/research/paper_cards --max-papers 10 && python3 scripts/build_evidence_graph.py --cards-dir data/research/paper_cards --output data/research/evidence/evidence_graph.v1.json --quality-output data/research/reports/research_quality_report.json && python3 scripts/validate_research_contracts.py --inputs data/research/paper_cards data/research/evidence --output data/runtime/research_contract_verify_report.json",
    "strategy:mvp": "tsx scripts/run_strategy_mvp_validation.ts --candidates docs/research/strategy_candidates.v1.json --output data/research/strategy/strategy_validation_runs.json",
    "strategy:g3g4:diagnose:fdr": "python3 scripts/diagnose_fdr_bottleneck.py",
    "strategy:g3g4:stagea:gate": "python3 scripts/build_stagea_gate_result.py",
    "strategy:g3g4:stageb:packet": "python3 scripts/build_stageb_governance_packet.py",
    "strategy:g3g4:policy:pack": "python3 scripts/build_quant_policy_pack.py",
    "strategy:g3g4:advisor:packet": "python3 scripts/build_advisor_committee_packet.py",
    "strategy:g3g4:hiring:scorecard": "python3 scripts/build_quant_hiring_scorecard.py",
    "strategy:g3g4:paper:board": "python3 scripts/build_problem_driven_paper_board.py",
    "strategy:g3g4:threshold:sensitivity": "python3 scripts/evaluate_threshold_sensitivity.py",
    "strategy:g3g4:decision:precontinue": "python3 scripts/build_precontinue_decision.py",
    "strategy:g3g4:compile-candidates": "python3 scripts/research_hypothesis_to_candidates.py",
    "decision:build": "python3 scripts/build_decision_packet.py --output-dir decision_packet --gate-checkpoints-dir data/runtime/gates --experiment-verdict data/research/strategy/experiment_verdict.v2.json",
    "decision:validate": "python3 scripts/validate_decision_packet.py --packet-dir decision_packet --output decision_packet/verdict.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "pytest scripts/tests -q",
    "test:all": "corepack pnpm test && corepack pnpm run test:py",
    "strategy:g3g4:switch": "python3 scripts/research_plan_switch.py --window 3 --fdr-weight 0.6 --wfo-weight 0.4",
    "strategy:g3g4:research:methodology-top2": "python3 scripts/research_methodology_execute.py --execute-chain --top-k 2 --continue-on-error",
    "strategy:g3g4:research:methodology-top2:dry": "python3 scripts/research_methodology_execute.py --top-k 2",
    "strategy:g3g4:legacy:status": "python3 -c \"print('Legacy G3/G4 strategy-loop commands were archived. See docs/research/archive/README.md and scripts/archive/legacy-research/README.md')\"",
    "stage-c:eval": "python3 scripts/stage_c_eval_harness.py",
    "stage-c:generate-candidates": "python3 scripts/stage_c_candidate_generator_v2.py",
    "stage-c:smoke-matrix": "python3 scripts/stage_c_smoke_matrix.py",
    "stage-c:round4:generate": "python3 scripts/stage_c_round4_candidate_generator.py",
    "stage-c:round4:run": "python3 scripts/stage_c_round4_mapping_runner.py",
    "paper:simulate:runtime": "tsx scripts/run_runtime_faithful_simulation.ts",
    "paper:execute:cycle": "tsx scripts/run_paper_demo_executor_cycle.ts",
    "research:tradingagents:scorecard": "tsx scripts/run_tradingagents_advisory_scorecard.ts",
    "paper:tradingagents:influence": "tsx scripts/run_tradingagents_execution_influence.ts",
    "canary:release": "tsx scripts/run_canary_release.ts"
  },
  "keywords": [
    "trading",
    "ai-agent",
    "crypto",
    "securities",
    "file-driven"
  ],
  "author": "Open Alice Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraderAlice/OpenAlice.git"
  },
  "homepage": "https://traderalice.com",
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.44",
    "@ai-sdk/google": "^3.0.30",
    "@ai-sdk/openai": "^3.0.30",
    "@alpacahq/alpaca-trade-api": "^3.1.3",
    "@grammyjs/auto-retry": "^2.0.2",
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@sinclair/typebox": "0.34.48",
    "ai": "^6.0.86",
    "ajv": "^8.18.0",
    "ccxt": "^4.5.38",
    "chalk": "^5.6.2",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "file-type": "^21.3.0",
    "grammy": "^1.40.0",
    "hono": "^4.11.9",
    "json5": "^2.2.3",
    "pino": "^10.3.1",
    "playwright-core": "1.58.2",
    "sharp": "^0.34.5",
    "tslog": "^4.10.2",
    "undici": "^7.22.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
