{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openalice/market_context.schema.v1.json",
  "title": "OpenAlice Market Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "symbol",
    "interval",
    "lookbackBars",
    "playheadTime",
    "availableSymbols",
    "source",
    "bars"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "market_context.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "interval": {
      "type": "string",
      "minLength": 1
    },
    "lookbackBars": {
      "type": "integer",
      "minimum": 1
    },
    "playheadTime": {
      "type": "string",
      "format": "date-time"
    },
    "availableSymbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "mode"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["native", "sidecar"]
        }
      }
    },
    "bars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "time",
          "open",
          "high",
          "low",
          "close",
          "volume",
          "tsOpenMs",
          "barIntervalMs",
          "barCloseMs",
          "completed",
          "sourceDomain"
        ],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "time": { "type": "integer", "minimum": 0 },
          "open": { "type": "number", "exclusiveMinimum": 0 },
          "high": { "type": "number", "exclusiveMinimum": 0 },
          "low": { "type": "number", "exclusiveMinimum": 0 },
          "close": { "type": "number", "exclusiveMinimum": 0 },
          "volume": { "type": "number", "minimum": 0 },
          "tsOpenMs": { "type": "integer", "minimum": 0 },
          "barIntervalMs": { "type": "integer", "minimum": 1 },
          "barCloseMs": { "type": "integer", "minimum": 0 },
          "completed": { "type": "boolean" },
          "sourceDomain": { "type": "string", "minLength": 1 },
          "instId": { "type": "string", "minLength": 1 },
          "ccxtSymbol": { "type": "string", "minLength": 1 },
          "clockSkewMs": { "type": "number" }
        }
      }
    }
  }
}
