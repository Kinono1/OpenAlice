{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openalice/threshold_sensitivity.schema.v1.json",
  "title": "OpenAlice Threshold Sensitivity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "threshold_sensitivity.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixReport", "matrixRunId"],
      "properties": {
        "matrixReport": { "type": "string", "minLength": 1 },
        "matrixRunId": { "type": ["string", "null"] }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenarioId", "description", "thresholds", "metrics", "deltaVsProd"],
        "properties": {
          "scenarioId": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "thresholds": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fdrQMax", "meanPboMax", "meanDsrProbabilityMin"],
            "properties": {
              "fdrQMax": { "type": "number" },
              "meanPboMax": { "type": "number" },
              "meanDsrProbabilityMin": { "type": "number" }
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eligibleAssetCount",
              "jointPassCount",
              "jointPassRate",
              "fdrBlockRate",
              "pboBlockRate",
              "dsrBlockRate",
              "wfoBlockRate"
            ],
            "properties": {
              "eligibleAssetCount": { "type": "integer", "minimum": 0 },
              "jointPassCount": { "type": "integer", "minimum": 0 },
              "jointPassRate": { "type": ["number", "null"] },
              "fdrBlockRate": { "type": ["number", "null"] },
              "pboBlockRate": { "type": ["number", "null"] },
              "dsrBlockRate": { "type": ["number", "null"] },
              "wfoBlockRate": { "type": ["number", "null"] }
            }
          },
          "deltaVsProd": {
            "type": "object",
            "additionalProperties": false,
            "required": ["jointPassRate", "fdrBlockRate"],
            "properties": {
              "jointPassRate": { "type": ["number", "null"] },
              "fdrBlockRate": { "type": ["number", "null"] }
            }
          }
        }
      }
    }
  }
}
