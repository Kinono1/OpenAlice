{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openalice/experiment_verdict.schema.v2.json",
  "title": "OpenAlice Experiment Verdict v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "result",
    "reasonCodes",
    "thresholds",
    "aggregateMetrics",
    "candidates",
    "outputPaths"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "experiment_verdict.v2"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "string",
      "enum": ["GO", "NO_GO", "GO_WITH_CONSTRAINTS"]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meanPboMax", "meanDsrProbabilityMin", "fdrQMax"],
      "properties": {
        "meanPboMax": { "type": "number" },
        "meanDsrProbabilityMin": { "type": "number" },
        "fdrQMax": { "type": "number" }
      }
    },
    "aggregateMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meanPbo", "meanDsrProbability", "fdrQ"],
      "properties": {
        "meanPbo": { "type": "number" },
        "meanDsrProbability": { "type": "number" },
        "fdrQ": { "type": "number" }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategyId",
          "strategyName",
          "status",
          "metrics",
          "releaseGate"
        ],
        "properties": {
          "strategyId": { "type": "string", "minLength": 1 },
          "strategyName": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pbo", "dsrProbability", "fdrQ"],
            "properties": {
              "pbo": { "type": "number" },
              "dsrProbability": { "type": "number" },
              "fdrQ": { "type": "number" }
            }
          },
          "releaseGate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowPaperTrading", "allowLiveTrading", "failedChecks"],
            "properties": {
              "allowPaperTrading": { "type": "boolean" },
              "allowLiveTrading": { "type": "boolean" },
              "failedChecks": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "failureReasonCode": { "type": "string" }
        }
      }
    },
    "outputPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationRuns", "releaseGateStatus"],
      "properties": {
        "validationRuns": { "type": "string", "minLength": 1 },
        "releaseGateStatus": { "type": "string", "minLength": 1 }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
