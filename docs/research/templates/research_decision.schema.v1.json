{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openalice/research_decision.schema.v1.json",
  "title": "OpenAlice Research Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "symbol",
    "decisionContext",
    "marketContext",
    "provenance",
    "strategy",
    "ml",
    "news",
    "releaseGate",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "research_decision.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "decisionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseGateMode"],
      "properties": {
        "releaseGateMode": {
          "type": "string",
          "enum": ["paper", "live", "auto"]
        }
      }
    },
    "marketContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lookbackBars", "windowStart", "windowEnd"],
      "properties": {
        "lookbackBars": {
          "type": "integer",
          "minimum": 1
        },
        "windowStart": {
          "type": "string",
          "format": "date-time"
        },
        "windowEnd": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "mode"],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["native", "sidecar"]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "sidecarRunId": {
          "type": "string",
          "minLength": 1
        },
        "inputHash": {
          "type": "string",
          "minLength": 1
        },
        "sourceRequestSchemaVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "reason"],
      "properties": {
        "signal": {
          "type": "integer",
          "enum": [-1, 0, 1]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "ensembleScore": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "selectedStrategy": {
          "type": "string",
          "minLength": 1
        },
        "selectorMode": {
          "type": "string",
          "minLength": 1
        },
        "selectorReason": {
          "type": "string",
          "minLength": 1
        },
        "indicators": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strategy", "signal", "strength", "reason"],
            "properties": {
              "strategy": {
                "type": "string",
                "minLength": 1
              },
              "signal": {
                "type": "integer",
                "enum": [-1, 0, 1]
              },
              "strength": {
                "type": "number"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "ml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "direction"],
      "properties": {
        "available": { "type": "boolean" },
        "direction": {
          "type": "string",
          "enum": ["buy", "sell", "hold"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "expectedReturnPct": {
          "type": "number"
        },
        "actionable": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "news": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalNews",
        "positiveNews",
        "negativeNews",
        "neutralNews",
        "highRiskNews",
        "sentimentScore",
        "riskScore",
        "topThemes",
        "flags"
      ],
      "properties": {
        "totalNews": { "type": "integer", "minimum": 0 },
        "positiveNews": { "type": "integer", "minimum": 0 },
        "negativeNews": { "type": "integer", "minimum": 0 },
        "neutralNews": { "type": "integer", "minimum": 0 },
        "highRiskNews": { "type": "integer", "minimum": 0 },
        "sentimentScore": { "type": "number" },
        "riskScore": { "type": "number" },
        "topThemes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["theme", "count"],
            "properties": {
              "theme": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["time", "title", "reason"],
            "properties": {
              "time": {
                "type": "string",
                "format": "date-time"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "latestHeadlines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["time", "title"],
            "properties": {
              "time": {
                "type": "string",
                "format": "date-time"
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "releaseGate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "allowPaperTrading",
        "allowLiveTrading",
        "failedChecks",
        "warningChecks"
      ],
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "allowPaperTrading": { "type": "boolean" },
        "allowLiveTrading": { "type": "boolean" },
        "failedChecks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warningChecks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "confidence",
        "tradeAllowed",
        "blockedBy",
        "reasons",
        "suggestedExposurePct"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["long", "short", "flat"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tradeAllowed": { "type": "boolean" },
        "blockedBy": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggestedExposurePct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
