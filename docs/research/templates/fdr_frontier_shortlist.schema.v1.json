{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openalice/fdr_frontier_shortlist.schema.v1.json",
  "title": "OpenAlice FDR Frontier Shortlist v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "generatedAt",
    "generatedDate",
    "inputs",
    "shortlist"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "fdr_frontier_shortlist.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generatedDate": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "digest",
        "citationNetwork",
        "pdfExtractReport",
        "hypotheses"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "citationNetwork": {
          "type": "string",
          "minLength": 1
        },
        "pdfExtractReport": {
          "type": "string",
          "minLength": 1
        },
        "hypotheses": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shortlist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shortlistItem"
      }
    }
  },
  "$defs": {
    "citations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citationCount",
        "inDegree",
        "outDegree"
      ],
      "properties": {
        "citationCount": {
          "type": "integer",
          "minimum": 0
        },
        "inDegree": {
          "type": "integer",
          "minimum": 0
        },
        "outDegree": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "shortlistItem": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "methodId",
        "paperId",
        "title",
        "venue",
        "year",
        "methodFamily",
        "fdrMechanism",
        "assumptions",
        "expectedImpactOnFdrQ",
        "expectedImpactOnWfo",
        "integrationCost",
        "riskLevel",
        "actionHint",
        "experimentTemplateId",
        "citations"
      ],
      "properties": {
        "methodId": {
          "type": "string",
          "minLength": 1
        },
        "paperId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 0
        },
        "methodFamily": {
          "type": "string",
          "minLength": 1
        },
        "fdrMechanism": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "string",
          "minLength": 1
        },
        "expectedImpactOnFdrQ": {
          "type": "string",
          "minLength": 1
        },
        "expectedImpactOnWfo": {
          "type": "string",
          "minLength": 1
        },
        "integrationCost": {
          "type": "string",
          "minLength": 1
        },
        "riskLevel": {
          "type": "string",
          "minLength": 1
        },
        "actionHint": {
          "type": "string",
          "minLength": 1
        },
        "experimentTemplateId": {
          "type": "string",
          "minLength": 1
        },
        "citations": {
          "$ref": "#/$defs/citations"
        }
      }
    }
  }
}
