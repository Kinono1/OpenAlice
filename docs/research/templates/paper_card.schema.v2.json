{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openalice/paper_card.schema.v2.json",
  "title": "OpenAlice Paper Card v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "paperId",
    "title",
    "venue",
    "source",
    "targets",
    "sections",
    "claims",
    "evidence",
    "trace"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "paper_card.v2"
    },
    "paperId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notePath", "textPath"],
      "properties": {
        "notePath": { "type": "string", "minLength": 1 },
        "textPath": { "type": "string", "minLength": 1 }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "method", "evidence", "limitations", "adaptation"],
      "properties": {
        "problem": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "limitations": { "type": "string", "minLength": 1 },
        "adaptation": { "type": "string", "minLength": 1 }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "text",
          "targetTags",
          "evidenceRefs",
          "confidence"
        ],
        "properties": {
          "claimId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "targetTags": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "text", "source"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "context": { "type": "string" }
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt", "generator", "inputManifest"],
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "generator": { "type": "string", "minLength": 1 },
        "inputManifest": { "type": "string", "minLength": 1 }
      }
    }
  }
}
